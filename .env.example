# ==============================================================================
# БЕЗОПАСНОСТЬ: Скопируйте этот шаблон в локальный файл .env командой:
#   cp .env.example .env
# Заполните реальные ключи в .env. Файл .env добавлен в .gitignore и никогда
# не должен попадать в git-репозиторий!
# ==============================================================================

# Groq — облачный диалог и аналитика ИИ (обязательно для навыка ИИ и авто-аналитики)
GROQ_API_KEY=
# Рекомендуемая быстрая модель: openai/gpt-oss-20b или qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-20b

# T-Invest API — приватный модуль портфеля и фонда модернизации
# TINKOFF_TOKEN: токен брокерского API (с правами торговли для сделок или только чтение)
TINKOFF_TOKEN=
# TINKOFF_ACCOUNT_ID: ID конкретного счёта (опционально; если пусто — определится автоматически)
TINKOFF_ACCOUNT_ID=
# TINKOFF_SANDBOX: режим песочницы для безопасного тестирования без реальных денег (true / false)
TINKOFF_SANDBOX=false
# TINKOFF_WATCHLIST: базовый список тикеров для наблюдения через запятую
TINKOFF_WATCHLIST=SBER,LKOH,YDEX,VTBR

# Telegram-бот: входящие команды и уведомления охраны
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Голос синтеза Piper TTS: ru_RU-dmitri-medium.onnx (мужской голос Дмитрия), ru_RU-ruslan-medium.onnx, ru_RU-irina-medium.onnx
PIPER_MODEL=ru_RU-dmitri-medium.onnx
VOICE_SPEED=1.0

# Погода по умолчанию: город (геокодинг) и/или точные координаты.
# Если заданы DEFAULT_LAT и DEFAULT_LON, «какая погода» без города идёт в эту точку.
# DEFAULT_CITY тогда только имя вслух; пустое имя озвучивается как «здесь».
DEFAULT_CITY=Москва
# DEFAULT_LAT=
# DEFAULT_LON=

# Лампа Xiaomi / Yeelight (опционально)
XIAOMI_BULB_IP=
XIAOMI_BULB_TOKEN=

# Сессия внимания (в секундах) в тишине и при играющей музыке
ATTENTION_TIMEOUT=6
ATTENTION_TIMEOUT_MUSIC=3

# Настройки приглушения музыки (Ducking) и фильтрации эхо колонок
# DUCKING_VOLUME: уровень звука Audacious при диалоге в % (по умолчанию 8)
DUCKING_VOLUME=8
# DUCKING_MODE: duck (приглушать) или pause (ставить плеер на паузу)
DUCKING_MODE=duck
# MIN_SPEECH_RMS: минимальная энергия голоса для отсечения фонового пения колонок (200 = оптимум, 0 = выкл)
MIN_SPEECH_RMS=200

# Поиск и карты: yandex или google
SEARCH_PROVIDER=yandex
MAPS_PROVIDER=yandex

# Браузерный ИИ по команде «открой нейросеть»: yandex (Алиса) или gemini
AI_PROVIDER=yandex

# Консольный режим и отображение GUI
# CONSOLE_MODE: запускать ассистент в текстовом терминале по умолчанию (true / false)
CONSOLE_MODE=false
# GUI_ENABLED: отображать плавающий виджет-сферу (true / false)
GUI_ENABLED=true
